// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "PCX Dev Container",
	"build": {
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": "..",
		"dockerfile": "../docker/Dockerfile"
	},
	"runArgs": [
		"--gpus",
		"all"
	],
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers-extra/features/vscode-cli:1": {},
		"ghcr.io/devcontainers-extra/features/vscode-server:1": {},
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"mounts": [
		// https://code.visualstudio.com/docs/devcontainers/tips-and-tricks#_persisting-user-profile
		"source=profile,target=/root,type=volume",
		"target=/root/.vscode-server,type=volume"
	],
	"containerEnv": {
		"SHELL": "/bin/bash",
		// Keep the venv out of the bind-mounted workspace so it doesn't collide with the host's.
		"UV_PROJECT_ENVIRONMENT": "/home/pcx/.venv",
		"UV_LINK_MODE": "copy",
		"XLA_PYTHON_CLIENT_PREALLOCATE": "false"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"astral-sh.ty",
				"tamasfe.even-better-toml",
				"ms-toolsai.jupyter",
				"ms-toolsai.vscode-jupyter-cell-tags",
				"ms-azuretools.vscode-docker",
				"nefrob.vscode-just-syntax"
			],
			"settings": {
				"python.defaultInterpreterPath": "/home/pcx/.venv/bin/python",
				"python.testing.pytestEnabled": true,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.organizeImports.ruff": "explicit"
					}
				}
			}
		}
	},
	// Sync the environment with the workspace's lockfile and install pcx itself as editable.
	"postCreateCommand": "uv sync --group dev",
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	"remoteUser": "pcx"
}
